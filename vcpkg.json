{
    "name": "vanillapdf-cli",
    "description": "PDF manipulation command-line tool",
    "features": {
        "cli11": {
            "description": "CLI argument parsing library",
            "dependencies": ["cli11"]
        },
        "encryption": {
            "description": "OpenSSL for vanillapdf encryption support",
            "dependencies": ["openssl"]
        },
        "jpeg": {
            "description": "libjpeg-turbo for vanillapdf JPEG support",
            "dependencies": ["libjpeg-turbo"]
        },
        "jpeg2000": {
            "description": "OpenJPEG for vanillapdf JPEG-2000 support",
            "dependencies": ["openjpeg"]
        },
        "zlib": {
            "description": "zlib for vanillapdf compression support",
            "dependencies": ["zlib"]
        },
        "spdlog": {
            "description": "spdlog for vanillapdf logging",
            "dependencies": ["spdlog"]
        },
        "fmt": {
            "description": "fmt formatting library (used by the CLI and vanillapdf)",
            "dependencies": ["fmt"]
        },
        "tests": {
            "description": "GoogleTest and nlohmann-json for the CLI unit tests",
            "dependencies": ["gtest", "nlohmann-json"]
        }
    }
}
