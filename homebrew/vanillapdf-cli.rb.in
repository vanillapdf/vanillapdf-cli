class VanillapdfCli < Formula
  desc "Command-line toolkit for PDF processing, validation and digital signatures"
  homepage "https://vanillapdf.com"
  url "https://github.com/vanillapdf/vanillapdf-cli/archive/refs/tags/@VANILLAPDF_CLI_RELEASE_TAG@.tar.gz"
  sha256 "@VANILLAPDF_CLI_SHA256@"
  license "Apache-2.0"
  head "https://github.com/vanillapdf/vanillapdf-cli.git", branch: "@VANILLAPDF_CLI_HEAD_BRANCH@"

  depends_on "cmake" => :build
  depends_on "cli11"
  depends_on "fmt"
  depends_on "vanillapdf"

  def install
    args = %w[
      -DVANILLAPDF_CLI_INTERNAL_VCPKG=OFF
      -DVANILLAPDF_CLI_EXTERNAL_VANILLAPDF=ON
      -DVANILLAPDF_CLI_EXTERNAL_CLI11=ON
      -DVANILLAPDF_CLI_EXTERNAL_FMT=ON
    ]

    system "cmake", "-S", ".", "-B", "build", *args, *std_cmake_args
    system "cmake", "--build", "build"
    system "cmake", "--install", "build"
  end

  test do
    assert_match version.to_s, shell_output("#{bin}/vanillapdf-cli --version")
  end
end
