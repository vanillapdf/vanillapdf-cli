{
    "version": 6,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 20,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "default",
            "displayName": "System packages (deb/rpm/brew)",
            "description": "All dependencies provided by the system. No vcpkg, no FetchContent.",
            "binaryDir": "${sourceDir}/build",
            "installDir": "${sourceDir}/install",
            "cacheVariables": {
                "VANILLAPDF_CLI_INTERNAL_VCPKG": "OFF",
                "VANILLAPDF_CLI_EXTERNAL_VANILLAPDF": "ON",
                "VANILLAPDF_CLI_EXTERNAL_CLI11": "ON"
            }
        },
        {
            "name": "vcpkg",
            "displayName": "Development (existing vcpkg installation)",
            "description": "Uses an existing vcpkg installation via VCPKG_ROOT. vanillapdf is built from source.",
            "binaryDir": "${sourceDir}/build",
            "installDir": "${sourceDir}/install",
            "cacheVariables": {
                "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake"
            }
        },
        {
            "name": "vcpkg-dev",
            "displayName": "Development (auto-vcpkg, vanillapdf main branch)",
            "description": "Auto-bootstraps vcpkg and builds vanillapdf from the main branch. No VCPKG_ROOT required.",
            "binaryDir": "${sourceDir}/build",
            "installDir": "${sourceDir}/install",
            "cacheVariables": {
                "VANILLAPDF_GIT_TAG": "main"
            }
        },
        {
            "name": "snap",
            "displayName": "Snap package (Ubuntu 24.04 system packages)",
            "description": "System packages for CLI11 and vanillapdf dependencies. vanillapdf built from source at the pinned tag in cmake/vanillapdf.cmake.",
            "binaryDir": "${sourceDir}/build",
            "installDir": "${sourceDir}/install",
            "cacheVariables": {
                "VANILLAPDF_CLI_INTERNAL_VCPKG": "OFF",
                "VANILLAPDF_CLI_EXTERNAL_VANILLAPDF": "OFF",
                "VANILLAPDF_CLI_EXTERNAL_CLI11": "ON",
                "BUILD_SHARED_LIBS": "OFF",
                "CMAKE_BUILD_TYPE": "Release",
                "VANILLAPDF_CLI_ENABLE_TESTS": "OFF"
            }
        },
        {
            "name": "vcpkg-static",
            "inherits": "vcpkg",
            "displayName": "Windows static (/MT — fully self-contained)",
            "description": "Static libs + static CRT (/MT). No runtime DLL dependencies whatsoever.",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            },
            "cacheVariables": {
                "VCPKG_TARGET_TRIPLET": "x64-windows-static",
                "BUILD_SHARED_LIBS": "OFF",
                "VANILLAPDF_USE_STATIC_CRT": "ON"
            }
        },
        {
            "name": "vcpkg-static-md",
            "inherits": "vcpkg",
            "displayName": "Windows static-md (/MD — static libs, dynamic CRT)",
            "description": "Static libs + dynamic MSVC runtime (/MD). All dependencies linked in; only UCRT/MSVCRT required at runtime.",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            },
            "cacheVariables": {
                "VCPKG_TARGET_TRIPLET": "x64-windows-static-md",
                "BUILD_SHARED_LIBS": "OFF"
            }
        }
    ]
}
