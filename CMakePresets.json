{
    "version": 6,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 20,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "default",
            "binaryDir": "${sourceDir}/build",
            "installDir": "${sourceDir}/install"
        },
        {
            "name": "vcpkg",
            "inherits": "default",
            "displayName": "Development (vcpkg)",
            "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake"
        },
        {
            "name": "vcpkg-dev",
            "inherits": "vcpkg",
            "displayName": "Development (vcpkg, vanillapdf from source)",
            "cacheVariables": {
                "VANILLAPDF_GIT_TAG": "main"
            }
        },
        {
            "name": "vcpkg-static",
            "inherits": "vcpkg",
            "displayName": "Standalone (vcpkg, static)",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            },
            "cacheVariables": {
                "VCPKG_TARGET_TRIPLET": "x64-windows-static"
            }
        }
    ]
}
